DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-32-plus-random-characters"
DASHSCOPE_API_KEY=""
DASHSCOPE_TEXT_MODEL="qwen3.7-flash"
DASHSCOPE_IMAGE_MODEL="qwen-image-3.0"
# Optional: API origin for your DashScope region
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com"
# Per merchant, resets at midnight Asia/Shanghai. Limits: 0 = unlimited.
AI_DAILY_IMAGE_LIMIT="10"
AI_DAILY_TEXT_LIMIT="30"
AI_MAX_CONCURRENT_IMAGES="1"
# Estimated CNY per attempt; set from your provider rates. 0 = no estimate.
AI_IMAGE_ESTIMATED_PRICE="0"
AI_TEXT_ESTIMATED_PRICE="0"
LOCAL_FILE_ROOT="./storage"
BLOB_READ_WRITE_TOKEN=""
